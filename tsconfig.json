{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [ "node" ]
  },
  "include": [ "*/src/**/*.ts", "*/server/**/*.ts", "*/spec/**/*.ts", "vitest.config.ts" ],
  "exclude": [ "*/spec/fixtures/**", "*/fixtures/**", "*/layouts/**" ]
}
