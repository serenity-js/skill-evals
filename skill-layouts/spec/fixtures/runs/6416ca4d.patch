diff --git a/src/calculation-jobs/ExchangeJobFiles.ts b/src/calculation-jobs/ExchangeJobFiles.ts
new file mode 100644
index 0000000..f3dc0c0
--- /dev/null
+++ b/src/calculation-jobs/ExchangeJobFiles.ts
@@ -0,0 +1,47 @@
+import { Ability } from '@serenity-js/core';
+import { randomUUID } from 'crypto';
+import { readFile, writeFile } from 'fs/promises';
+import path from 'path';
+import { ensure, isNotBlank } from 'tiny-types';
+
+/**
+ * Enables an actor to submit calculation jobs by writing a file to the jobs directory,
+ * and to collect the result from the file of the same name in the results directory.
+ */
+export class ExchangeJobFiles extends Ability {
+    static using(jobsDirectory: string, resultsDirectory: string): ExchangeJobFiles {
+        return new ExchangeJobFiles(jobsDirectory, resultsDirectory);
+    }
+
+    private lastJobFileName: string | undefined;
+
+    constructor(
+        private readonly jobsDirectory: string,
+        private readonly resultsDirectory: string,
+    ) {
+        super();
+        ensure('jobsDirectory', jobsDirectory, isNotBlank());
+        ensure('resultsDirectory', resultsDirectory, isNotBlank());
+    }
+
+    async writeJobFile(expression: string): Promise<void> {
+        // unique, so that a result left by an earlier run is never mistaken for this job's result
+        const fileName = `job-${ randomUUID() }.txt`;
+        await writeFile(path.join(this.jobsDirectory, fileName), expression, 'utf8');
+        this.lastJobFileName = fileName;
+    }
+
+    async readResultFile(): Promise<string | undefined> {
+        if (! this.lastJobFileName) {
+            return undefined;
+        }
+        try {
+            return await readFile(path.join(this.resultsDirectory, this.lastJobFileName), 'utf8');
+        } catch (error) {
+            if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+                return undefined;
+            }
+            throw error;
+        }
+    }
+}
