+import { Answerable, Duration, Interaction, Question, QuestionAdapter, Task, the, Wait } from '@serenity-js/core';
 
+import { ExchangeJobFiles } from './ExchangeJobFiles';
 import { RunCalculationJobs } from './RunCalculationJobs';
 
 const SubmitAJob = (expression: Answerable<string>) =>
@@ -21,3 +23,19 @@ export const ResultOfLastJob = () =>
     Question.about('the result of the last job', actor =>
         RunCalculationJobs.as(actor).resultOfLastJob()
     );
+
+const WriteAJobFile = (expression: Answerable<string>) =>
+    Interaction.where(the`#actor writes a job file with ${ expression }`, async actor => {
+        ExchangeJobFiles.as(actor).writeJobFile(await actor.answer(expression));
+    });
+
+export const ResultFileOfLastJob = (): QuestionAdapter<string | undefined> =>
+    Question.about('the result file of the last job', actor =>
+        ExchangeJobFiles.as(actor).resultFileOfLastJob()
+    );
+
+export const CalculateInBackgroundWithAJobFile = (expression: Answerable<string>): Task =>
+    Task.where(the`#actor calculates ${ expression } in the background with a job file`,
+        WriteAJobFile(expression),
+        Wait.upTo(Duration.ofSeconds(3)).until(ResultFileOfLastJob(), isPresent()),
+    );
