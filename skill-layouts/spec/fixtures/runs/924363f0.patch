+const WriteAJobFile = (expression: Answerable<string>): Interaction =>
+    Interaction.where(the`#actor writes a job file containing ${ expression }`, async actor => {
+        RunCalculationJobs.as(actor).submitAsFile(await actor.answer(expression));
+    });
+
+export const CalculateFromFile = (expression: Answerable<string>): Task =>
+    Task.where(the`#actor calculates ${ expression } by submitting a job file`,
+        WriteAJobFile(expression),
+    );
+
 export const StatusOfLastJob = () =>
