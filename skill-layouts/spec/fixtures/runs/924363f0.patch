@@ -1,4 +1,7 @@
 import { Ability } from '@serenity-js/core';
+import { randomUUID } from 'crypto';
+import { existsSync, readFileSync, rmSync, writeFileSync } from 'fs';
+import path from 'path';
 
 import { CalculationJobs } from './CalculationJobs';
 
@@ -8,6 +11,8 @@ export class RunCalculationJobs extends Ability {
     }
 
     private lastJobId: string | undefined;
+    private readonly jobFileNames: string[] = [];
+    private lastJobFileName: string | undefined;
 
     constructor(private readonly jobs: CalculationJobs) {
         super();
@@ -24,4 +29,26 @@ export class RunCalculationJobs extends Ability {
     resultOfLastJob(): string | undefined {
         return this.lastJobId ? this.jobs.result(this.lastJobId) : undefined;
     }
+
+    submitAsFile(expression: string): void {
+        const fileName = `${ randomUUID() }.txt`;
+        this.jobFileNames.push(fileName);
+        this.lastJobFileName = fileName;
+        writeFileSync(path.join(this.jobs.jobsDirectory, fileName), expression);
+    }
+
+    resultOfLastJobFile(): string | undefined {
+        const resultFile = this.lastJobFileName && path.join(this.jobs.resultsDirectory, this.lastJobFileName);
+
+        return resultFile && existsSync(resultFile)
+            ? readFileSync(resultFile, 'utf8')
+            : undefined;
+    }
+
+    discard(): void {
+        for (const fileName of this.jobFileNames) {
+            rmSync(path.join(this.jobs.jobsDirectory, fileName), { force: true });
+            rmSync(path.join(this.jobs.resultsDirectory, fileName), { force: true });
+        }
+    }
 }
