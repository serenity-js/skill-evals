@@ -1,4 +1,7 @@
 import { Ability } from '@serenity-js/core';
+import { randomUUID } from 'crypto';
+import { existsSync, readFileSync, writeFileSync } from 'fs';
+import path from 'path';
 
 import { CalculationJobs } from './CalculationJobs';
 
@@ -8,6 +11,7 @@ export class RunCalculationJobs extends Ability {
     }
 
     private lastJobId: string | undefined;
+    private lastJobFileName: string | undefined;
 
     constructor(private readonly jobs: CalculationJobs) {
         super();
@@ -24,4 +28,30 @@ export class RunCalculationJobs extends Ability {
     resultOfLastJob(): string | undefined {
         return this.lastJobId ? this.jobs.result(this.lastJobId) : undefined;
     }
+
+    /**
+     * Submits the job by writing the expression to a uniquely named file in the jobs directory,
+     * so that a result left over from an earlier run can't be mistaken for this job's.
+     */
+    submitAsFile(expression: string): void {
+        this.lastJobFileName = `${ randomUUID() }.txt`;
+        writeFileSync(path.join(this.jobs.jobsDirectory, this.lastJobFileName), expression);
+    }
+
+    /**
+     * The contents of the result file of the last job submitted as a file,
+     * or `undefined` until the service has written them.
+     */
+    resultOfLastJobFile(): string | undefined {
+        if (! this.lastJobFileName) {
+            return undefined;
+        }
+
+        const resultFile = path.join(this.jobs.resultsDirectory, this.lastJobFileName);
+
+        // a file that's still being written is empty
+        return existsSync(resultFile)
+            ? readFileSync(resultFile, 'utf8') || undefined
+            : undefined;
+    }
 }
