 const SubmitAJob = (expression: Answerable<string>) =>
@@ -12,6 +14,17 @@ export const CalculateInBackground = (expression: Answerable<string>) =>
         SubmitAJob(expression),
     );
 
+const WriteAJobFile = (expression: Answerable<string>) =>
+    Interaction.where(the`#actor writes a job file with ${ expression }`, async actor => {
+        ExchangeJobFiles.as(actor).writeJobFile(await actor.answer(expression));
+    });
+
+export const CalculateInBackgroundUsingFiles = (expression: Answerable<string>): Task =>
+    Task.where(the`#actor calculates ${ expression } in the background using job files`,
+        WriteAJobFile(expression),
+        Wait.until(ResultFileOfLastJob(), isPresent()),
+    );
+
 export const StatusOfLastJob = () =>
     Question.about('the status of the last job', actor =>
         RunCalculationJobs.as(actor).statusOfLastJob()
@@ -21,3 +34,8 @@ export const ResultOfLastJob = () =>
