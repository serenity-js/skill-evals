+type CalculatedExpressions = { result: string[], error: string | null };
+
+export const CalculateToSignificantDigits = (expression: Answerable<string>, precision: Answerable<number>): Task =>
+    Task.where(the`#actor calculates ${ expression } to ${ precision } significant digits`,
