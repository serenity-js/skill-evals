diff --git a/src/calculation-jobs/UseJobFiles.ts b/src/calculation-jobs/UseJobFiles.ts
new file mode 100644
index 0000000..0305aa7
--- /dev/null
+++ b/src/calculation-jobs/UseJobFiles.ts
@@ -0,0 +1,52 @@
+import { Ability } from '@serenity-js/core';
+import { randomUUID } from 'crypto';
+import { mkdir, readFile, writeFile } from 'fs/promises';
+import { join } from 'path';
+import { ensure, isNotBlank } from 'tiny-types';
+
+/**
+ * Enables an actor to submit calculation jobs as files written to `jobsDirectory`,
+ * and to read the results the service writes to a file of the same name in `resultsDirectory`.
+ */
+export class UseJobFiles extends Ability {
+    static at(jobsDirectory: string, resultsDirectory: string): UseJobFiles {
+        return new UseJobFiles(jobsDirectory, resultsDirectory);
+    }
+
+    private lastJobFileName: string | undefined;
+
+    constructor(
+        private readonly jobsDirectory: string,
+        private readonly resultsDirectory: string,
+    ) {
+        super();
+        ensure('jobsDirectory', jobsDirectory, isNotBlank());
+        ensure('resultsDirectory', resultsDirectory, isNotBlank());
+    }
+
+    async writeJobFile(expression: string): Promise<void> {
+        // a name of its own, so that a result left by an earlier run can't be mistaken for this job's
+        const fileName = `job-${ randomUUID() }.txt`;
+
+        await mkdir(this.jobsDirectory, { recursive: true });
+        await writeFile(join(this.jobsDirectory, fileName), expression);
+
+        this.lastJobFileName = fileName;
+    }
+
+    async resultFileOfLastJob(): Promise<string | undefined> {
+        if (! this.lastJobFileName) {
+            return undefined;
+        }
+
+        try {
+            return await readFile(join(this.resultsDirectory, this.lastJobFileName), 'utf8');
+        }
+        catch (error) {
+            if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
+                return undefined;
+            }
+            throw error;
+        }
+    }
+}
