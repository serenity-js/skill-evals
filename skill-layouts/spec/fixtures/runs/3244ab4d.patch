+import { Answerable, Interaction, Question, Task, the, Wait } from '@serenity-js/core';
 
 import { RunCalculationJobs } from './RunCalculationJobs';
+import { UseJobFiles } from './UseJobFiles';
 
 const SubmitAJob = (expression: Answerable<string>) =>
     Interaction.where(the`#actor submits a job to calculate ${ expression }`, async actor => {
         RunCalculationJobs.as(actor).submit(await actor.answer(expression));
     });
 
+const WriteAJobFile = (expression: Answerable<string>) =>
+    Interaction.where(the`#actor writes a job file with ${ expression }`, async actor => {
+        UseJobFiles.as(actor).writeJobFile(await actor.answer(expression));
+    });
+
 export const CalculateInBackground = (expression: Answerable<string>) =>
     Task.where(the`#actor calculates ${ expression } in the background`,
         SubmitAJob(expression),
@@ -21,3 +28,14 @@ export const ResultOfLastJob = () =>
     Question.about('the result of the last job', actor =>
         RunCalculationJobs.as(actor).resultOfLastJob()
     );
+
+export const ResultFileOfLastJob = () =>
+    Question.about('the result file of the last job', actor =>
+        UseJobFiles.as(actor).resultFileOfLastJob()
+    );
+
+export const CalculateInBackgroundUsingAJobFile = (expression: Answerable<string>) =>
+    Task.where(the`#actor calculates ${ expression } in the background using a job file`,
+        WriteAJobFile(expression),
+        Wait.until(ResultFileOfLastJob(), isPresent()),
+    );
