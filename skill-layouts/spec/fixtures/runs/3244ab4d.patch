diff --git a/src/calculation-jobs/UseJobFiles.ts b/src/calculation-jobs/UseJobFiles.ts
new file mode 100644
index 0000000..e186ad7
--- /dev/null
+++ b/src/calculation-jobs/UseJobFiles.ts
@@ -0,0 +1,42 @@
+import { Ability } from '@serenity-js/core';
+import { randomUUID } from 'crypto';
+import { existsSync, readFileSync, writeFileSync } from 'fs';
+import path from 'path';
+import { ensure, isNotBlank } from 'tiny-types';
+
+/**
+ * Lets an actor submit calculation jobs as files written to `jobsDirectory`,
+ * and read their results from files of the same name in `resultsDirectory`.
+ */
+export class UseJobFiles extends Ability {
+    static using(jobsDirectory: string, resultsDirectory: string): UseJobFiles {
+        return new UseJobFiles(jobsDirectory, resultsDirectory);
+    }
+
+    private lastJobFileName: string | undefined;
+
+    constructor(
+        private readonly jobsDirectory: string,
+        private readonly resultsDirectory: string,
+    ) {
+        super();
+        ensure('jobsDirectory', jobsDirectory, isNotBlank());
+        ensure('resultsDirectory', resultsDirectory, isNotBlank());
+    }
+
+    writeJobFile(expression: string): void {
+        // a name of its own, so that a file left by an earlier run can't be mistaken for this job's result
+        this.lastJobFileName = `job-${ randomUUID() }.txt`;
+        writeFileSync(path.join(this.jobsDirectory, this.lastJobFileName), expression);
+    }
+
+    resultFileOfLastJob(): string | undefined {
+        if (! this.lastJobFileName) {
+            return undefined;
+        }
+
+        const resultFile = path.join(this.resultsDirectory, this.lastJobFileName);
+
+        return existsSync(resultFile) ? readFileSync(resultFile, 'utf8') : undefined;
+    }
+}
