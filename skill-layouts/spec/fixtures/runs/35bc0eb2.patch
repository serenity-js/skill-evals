 import { Answerable, Interaction, Question, Task, the } from '@serenity-js/core';
 
+import { ExchangeJobFiles } from './ExchangeJobFiles';
 import { RunCalculationJobs } from './RunCalculationJobs';
 
 const SubmitAJob = (expression: Answerable<string>) =>
@@ -21,3 +22,18 @@ export const ResultOfLastJob = () =>
     Question.about('the result of the last job', actor =>
         RunCalculationJobs.as(actor).resultOfLastJob()
     );
+
+const WriteAJobFile = (expression: Answerable<string>) =>
+    Interaction.where(the`#actor writes a job file to calculate ${ expression }`, async actor => {
+        ExchangeJobFiles.as(actor).submit(await actor.answer(expression));
+    });
+
+export const CalculateViaJobFile = (expression: Answerable<string>) =>
+    Task.where(the`#actor calculates ${ expression } by submitting a job file`,
+        WriteAJobFile(expression),
+    );
+
+export const ResultFileOfLastJob = () =>
+    Question.about('the result file of the last job', actor =>
+        ExchangeJobFiles.as(actor).resultOfLastJob()
+    );
