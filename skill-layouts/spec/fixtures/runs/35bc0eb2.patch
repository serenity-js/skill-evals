diff --git a/src/calculation-jobs/ExchangeJobFiles.ts b/src/calculation-jobs/ExchangeJobFiles.ts
new file mode 100644
index 0000000..ed1e921
--- /dev/null
+++ b/src/calculation-jobs/ExchangeJobFiles.ts
@@ -0,0 +1,49 @@
+import { Ability } from '@serenity-js/core';
+import { randomUUID } from 'crypto';
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'fs';
+import path from 'path';
+import { ensure, isNotBlank } from 'tiny-types';
+
+/**
+ * Lets an actor submit calculation jobs by writing files to `jobsDirectory`,
+ * and collect their results from files of the same name in `resultsDirectory`.
+ */
+export class ExchangeJobFiles extends Ability {
+    static at(jobsDirectory: string, resultsDirectory: string): ExchangeJobFiles {
+        return new ExchangeJobFiles(jobsDirectory, resultsDirectory);
+    }
+
+    private lastJobFileName: string | undefined;
+
+    constructor(
+        private readonly jobsDirectory: string,
+        private readonly resultsDirectory: string,
+    ) {
+        super();
+        ensure('jobsDirectory', jobsDirectory, isNotBlank());
+        ensure('resultsDirectory', resultsDirectory, isNotBlank());
+    }
+
+    submit(expression: string): void {
+        // the service picks up every file name only once, so each job needs a name of its own
+        const fileName = `${ randomUUID() }.txt`;
+
+        mkdirSync(this.jobsDirectory, { recursive: true });
+        writeFileSync(path.join(this.jobsDirectory, fileName), expression);
+
+        this.lastJobFileName = fileName;
+    }
+
+    resultOfLastJob(): string | undefined {
+        if (! this.lastJobFileName) {
+            return undefined;
+        }
+
+        const resultFile = path.join(this.resultsDirectory, this.lastJobFileName);
+
+        // the service may create the file before it finishes writing it
+        const result = existsSync(resultFile) ? readFileSync(resultFile, 'utf8') : '';
+
+        return result === '' ? undefined : result;
+    }
+}
