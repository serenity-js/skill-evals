+
+    resultFileOfLastJob(): string | undefined {
+        return this.lastJobFileName ? this.jobs.resultFile(this.lastJobFileName) : undefined;
+    }
+
+    async discard(): Promise<void> {
+        for (const fileName of this.jobFileNames) {
