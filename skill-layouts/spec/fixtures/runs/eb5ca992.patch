         this.lastJobId = this.jobs.submit(expression);
     }
 
+    submitFile(expression: string): void {
+        // a name of its own, so that a result file left by an earlier run is never mistaken for this job's result
+        const fileName = `${ randomUUID() }.txt`;
+        this.lastJobFileName = fileName;
+        this.jobFileNames.push(fileName);
+        this.jobs.submitFile(fileName, expression);
