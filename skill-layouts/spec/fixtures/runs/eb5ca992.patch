-import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from 'fs';
+import { existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'fs';
 import { join } from 'path';
 import { ensure, isNotBlank } from 'tiny-types';
 
@@ -34,6 +34,27 @@ export class CalculationJobs {
         return id;
     }
 
+    /**
+     * Submits a job by writing the expression to a file in the jobs directory
+     */
+    submitFile(fileName: string, expression: string): void {
+        writeFileSync(join(this.jobsDirectory, fileName), expression);
+    }
+
+    /**
+     * Returns the contents of the result file the service wrote for the job file of the same name,
+     * or `undefined` when there's no such file yet
+     */
+    resultFile(fileName: string): string | undefined {
+        const path = join(this.resultsDirectory, fileName);
+        return existsSync(path) ? readFileSync(path, 'utf8') : undefined;
+    }
+
+    removeFiles(fileName: string): void {
+        rmSync(join(this.jobsDirectory, fileName), { force: true });
+        rmSync(join(this.resultsDirectory, fileName), { force: true });
+    }
+
     status(id: string): 'pending' | 'done' {
         return this.results.has(id) ? 'done' : 'pending';
     }
